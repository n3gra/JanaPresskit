# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- material de trabajo, no es codigo del sitio ---------------------------
# Se quedan en el disco: solo no viajan adentro del repo.

# Repos de referencia bajados para mirar (weave-ds-template, etc).
# Vendorear el repo de otro adentro del propio ensucia diffs y licencias.
/repo_paraver

# Capturas y salidas que generan las skills de revision. Se regeneran solas.
/.impeccable
/DESIGN.md

# Scripts sueltos de captura.
/shot.cjs
